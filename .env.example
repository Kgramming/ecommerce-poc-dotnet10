# Copy to .env (or export) before running. Defaults already match the Mac data stack.
# PostgreSQL (source of truth) — Mac Docker host port 5435
PGHOST=localhost
PGPORT=5435
PGDATABASE=ecommerce
PGUSER=ecommerce
PGPASSWORD=ecommerce

# MongoDB (product catalog)
MONGOHOST=localhost
MONGOPORT=27017
MONGODB=ecommerce

# Elasticsearch (admin search / read model)
ESHOST=localhost
ESPORT=9200
ESINDEX=orders

# Sync strategy: dual_write | polling
SYNC_STRATEGY=dual_write
